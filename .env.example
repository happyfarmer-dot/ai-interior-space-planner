# ==============================================================================
# SpatialMind AI — Google Gemini AI & App Build Configuration
# Copy to .env.local if you want to bake a default Gemini API key at build time.
# Note: End-users can also configure & save their API Key directly in the UI / APK!
# ==============================================================================

# Optional build-time Gemini API Key (Google AI Studio)
VITE_GEMINI_API_KEY=

# Vision / JSON Spatial Analysis model (Default: gemini-3.5-flash-lite)
# Options: gemini-3.5-flash-lite | gemini-3.8-flash | gemini-3-flash-preview | gemini-2.5-flash-lite
VITE_GEMINI_VISION_MODEL=gemini-3.5-flash-lite

# Native Image Generation / Editing model (Default: gemini-nano-banana-2.1)
# Options: gemini-nano-banana-2.1 | gemini-3.1-flash-image | gemini-3.1-flash-lite-image | gemini-3-pro-image
VITE_GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
