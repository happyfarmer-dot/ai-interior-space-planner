# ==============================================================================
# SpatialMind AI — AI Service Pipeline Environment Configuration
# Copy to .env.local and provide endpoints/keys to switch from Mock Mode to Live API.
# ==============================================================================

# 'mock' (default offline interactive simulation) | 'live' (external VLM/Diffusion/LLM APIs)
VITE_AI_MODE=mock

# 1. Vision-Language Model (VLM) for Object Detection, MEP Identification & Visual Search
VITE_VLM_API_URL=https://api.openai.com/v1/chat/completions
VITE_VLM_API_KEY=

# 2. Diffusion / ControlNet / Inpainting API for Style Transfer & Local Material Replacement
VITE_DIFFUSION_API_URL=https://api.replicate.com/v1/predictions
VITE_DIFFUSION_API_KEY=

# 3. LLM API for Natural Language Design Constraint Parsing (JSON Constraints)
VITE_LLM_API_URL=https://api.openai.com/v1/chat/completions
VITE_LLM_API_KEY=

# 4. Optional Product Visual Search API (IKEA / MUJI / NITORI Catalog Endpoint)
VITE_PRODUCT_SEARCH_API_URL=
